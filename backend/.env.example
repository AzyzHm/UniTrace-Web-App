NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net

ALLOWED_EMAIL_DOMAINS=isamm.uma.tn,isamm.u-manouba.tn

AGENTMAIL_API_KEY=<Your_agentmail_api_key>
AGENTMAIL_INBOX_ID=<Your_agentmail_inbox_id>

CODE_HASH_SECRET=dev-only-code-hash-secret-change-me

JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me
JWT_ACCESS_EXPIRES=15m

UPLOAD_DIR=uploads

# Browser origins allowed to call the API directly (CORS), comma separated, no
# trailing slash. Leave empty when the frontend goes through the Vite proxy.
CORS_ORIGINS=

# Number of reverse proxies in front of the API (Nginx, a hosting platform...).
# 0 when there is none. It makes the rate limits see the real client address.
TRUST_PROXY=0