[
  {
    "name": "Matching",
    "item": [
      {
        "name": "List my correspondences",
        "request": {
          "method": "GET",
          "url": {
            "raw": "{{baseUrl}}/api/v1/correspondences?page=1&limit=20",
            "host": ["{{baseUrl}}"],
            "path": ["api", "v1", "correspondences"],
            "query": [
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "20" },
              { "key": "status", "value": "pending", "disabled": true }
            ]
          },
          "description": "All the matches found for the declarations of the logged-in user."
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('status is 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "const list = body.correspondences || body.items || body.data || [];",
                "if (list.length) pm.collectionVariables.set('correspondenceId', list[0].id);"
              ]
            }
          }
        ]
      },
      {
        "name": "List correspondences of a declaration",
        "request": {
          "method": "GET",
          "url": {
            "raw": "{{baseUrl}}/api/v1/declarations/{{declarationId}}/correspondences?page=1&limit=20",
            "host": ["{{baseUrl}}"],
            "path": ["api", "v1", "declarations", "{{declarationId}}", "correspondences"],
            "query": [
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "20" }
            ]
          }
        }
      },
      {
        "name": "Get correspondence",
        "request": {
          "method": "GET",
          "url": "{{baseUrl}}/api/v1/correspondences/{{correspondenceId}}"
        }
      },
      {
        "name": "Confirm correspondence",
        "request": {
          "method": "PATCH",
          "url": "{{baseUrl}}/api/v1/correspondences/{{correspondenceId}}/confirm",
          "description": "No body. Confirms that the matched declaration is the right one."
        }
      },
      {
        "name": "Reject correspondence",
        "request": {
          "method": "PATCH",
          "url": "{{baseUrl}}/api/v1/correspondences/{{correspondenceId}}/reject",
          "description": "No body. Says the matched declaration is not the right one."
        }
      }
    ]
  },
  {
    "name": "Notifications",
    "item": [
      {
        "name": "List my notifications",
        "request": {
          "method": "GET",
          "url": {
            "raw": "{{baseUrl}}/api/v1/notifications?page=1&limit=20",
            "host": ["{{baseUrl}}"],
            "path": ["api", "v1", "notifications"],
            "query": [
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "20" },
              { "key": "unread", "value": "true", "disabled": true }
            ]
          }
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('status is 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "const list = body.notifications || body.items || body.data || [];",
                "if (list.length) pm.collectionVariables.set('notificationId', list[0].id);"
              ]
            }
          }
        ]
      },
      {
        "name": "Unread count",
        "request": {
          "method": "GET",
          "url": "{{baseUrl}}/api/v1/notifications/unread-count"
        }
      },
      {
        "name": "Mark one as read",
        "request": {
          "method": "PATCH",
          "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read"
        }
      },
      {
        "name": "Mark all as read",
        "request": {
          "method": "PATCH",
          "url": "{{baseUrl}}/api/v1/notifications/read-all"
        }
      },
      {
        "name": "Delete notification",
        "request": {
          "method": "DELETE",
          "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}"
        }
      }
    ]
  }
]