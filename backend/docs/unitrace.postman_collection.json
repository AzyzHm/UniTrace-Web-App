                  "key": "picture",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Remove picture",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/declarations/{{declarationId}}/picture"
          }
        }
      ]
    }
  ]
}
